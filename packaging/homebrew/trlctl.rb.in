class Trlctl < Formula
  desc "Scaffold and validate repositories that follow the therealm Argo CD layout"
  homepage "https://github.com/therealm-tech/trlctl"
  version "@VERSION@"
  license "MIT"

  on_macos do
    on_arm do
      url "https://github.com/therealm-tech/trlctl/releases/download/v@VERSION@/trlctl-@VERSION@-aarch64-apple-darwin.tar.gz"
      sha256 "@SHA256_AARCH64_APPLE_DARWIN@"
    end
    on_intel do
      url "https://github.com/therealm-tech/trlctl/releases/download/v@VERSION@/trlctl-@VERSION@-x86_64-apple-darwin.tar.gz"
      sha256 "@SHA256_X86_64_APPLE_DARWIN@"
    end
  end

  on_linux do
    on_arm do
      url "https://github.com/therealm-tech/trlctl/releases/download/v@VERSION@/trlctl-@VERSION@-aarch64-unknown-linux-musl.tar.gz"
      sha256 "@SHA256_AARCH64_UNKNOWN_LINUX_MUSL@"
    end
    on_intel do
      url "https://github.com/therealm-tech/trlctl/releases/download/v@VERSION@/trlctl-@VERSION@-x86_64-unknown-linux-musl.tar.gz"
      sha256 "@SHA256_X86_64_UNKNOWN_LINUX_MUSL@"
    end
  end

  def install
    bin.install "trlctl"
  end

  test do
    assert_match version.to_s, shell_output("#{bin}/trlctl --version")
  end
end
